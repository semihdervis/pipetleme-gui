                    <string notr="true">QLabel{
	font-size : 15px;
	padding-left: 7px;
}

QLineEdit{
border: 1px solid darkgrey;
border-radius :5px;
font-size : 15px;
}

QComboBox{
border: 1px solid darkgrey;
border-radius :5px;
font-size : 15px;
}

QDoubleSpinBox{
border: 1px solid darkgrey;
border-radius :5px;
font-size : 15px;
}

QSpinBox{
border: 1px solid darkgrey;
border-radius :5px;
font-size : 15px;
}

QCheckBox{
font-size : 9pt;
}

QPushButton{
	border: 1px solid;
	border-color: rgb(150, 150, 150);
	font-size: 10pt;
	border-radius :8px;
}

QPushButton:hover {
    background-color: rgb(230, 230, 230);
}

QPushButton:pressed {
    background-color: rgb(200, 200, 200);
}

QGroupBox {
	 border: 2px solid #b0b0b0;
	 border-radius: 10px; 
     margin-top: 20px;
     background-color: #f0f0f0;
     font:bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
	padding: 0 10px; 
	color: #404040; 
	background-color: #d9d9d9; 
	border: 1px solid #a0a0a0; 
	border-radius: 5px;
}

QListWidget {
    border: 2px solid #b0b0b0;
    border-radius: 10px; 
    background-color: #f0f0f0;
    padding: 5px; 
    font: 10pt; 
    color: #404040; 
}

QListWidget::item {
    padding: 5px; 
    margin: 3px; 
    border: 1px solid #d0d0d0; 
    background-color: #ffffff; 
    border-radius: 5px; 
	height : 50px;
}

QListWidget::item:selected {
    background-color: #d9d9d9;
    color: #000000; 
    border: 1px solid #a0a0a0;
}</string>
