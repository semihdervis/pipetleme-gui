   <string notr="true">/* QToolButton */
QToolButton {
    background-color:rgba(0, 0, 0, 0);
    color: #000000;
    border-radius: 10px;
}

QToolButton:hover {
    background-color:rgba(0, 0, 0,0.05);
}

QToolButton[active=&quot;true&quot;] {
    font-weight: bold;
    padding-left: 15px;
    background-color: #4272FF;
    color:rgb(255, 255, 255);
}

QToolButton[active=&quot;false&quot;] {
    font-weight: bold;
    padding-left: 15px;
    background-color:rgba(0, 0, 0, 0);
    color: #000000;
}

QToolButton[active=&quot;false&quot;]:hover {
    background-color:rgba(0, 0, 0,0.05);
}

QToolButton[active=&quot;false&quot;]:pressed {
    background-color:rgba(0, 0, 0,0.1);
}



/* QTabWidget */
QTabWidget::pane {
    border: 1px solid rgba(0,0,0,40);
	border-bottom-left-radius: 5px; 
	border-bottom-right-radius: 5px;
	border-top-right-radius: 5px; 
}

QTabWidget::tab-bar:top {
    top: 1px;
}

QTabWidget::tab-bar:bottom {
    bottom: 1px;
}

QTabWidget::tab-bar:left {
    right: 1px;
}

QTabWidget::tab-bar:right {
    left: 1px;
}

QTabBar::tab {
    border: 1px solid rgba(0,0,0,40);
	border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:selected {
	background-color: #4272FF;
    color: #FFFFFF;
	margin-bottom: -1px; 
}

QTabBar::tab:!selected {
    background: rgba(0,0,0,60);
	margin-bottom: -1px; 
}

QTabBar::tab:!selected:hover {
    background: #999;
}

QTabBar::tab:top:!selected {
    margin-top: 3px;
}

QTabBar::tab:bottom:!selected {
    margin-bottom: 3px;
}

QTabBar::tab:top, QTabBar::tab:bottom {
    min-width: 8ex;
    margin-right: -1px;
    padding: 5px 10px 5px 10px;
}

QTabBar::tab:top:selected {
    border-bottom-color: none;
}

QTabBar::tab:bottom:selected {
    border-top-color: none;
}

QTabBar::tab:top:last, QTabBar::tab:bottom:last,
QTabBar::tab:top:only-one, QTabBar::tab:bottom:only-one {
    margin-right: 0;
}

QTabBar::tab:left:!selected {
    margin-right: 3px;
}

QTabBar::tab:right:!selected {
    margin-left: 3px;
}

QTabBar::tab:left, QTabBar::tab:right {
    min-height: 8ex;
    margin-bottom: -1px;
    padding: 10px 5px 10px 5px;
}

QTabBar::tab:left:selected {
    border-left-color: none;
}

QTabBar::tab:right:selected {
    border-right-color: none;
}

QTabBar::tab:left:last, QTabBar::tab:right:last,
QTabBar::tab:left:only-one, QTabBar::tab:right:only-one {
    margin-bottom: 0;
}

/* QTableWidget */
/* Base table styles */
QTableWidget {
    border-radius: 8px;
    background-color: rgba(0,0,0,0);
    gridline-color: rgba(0, 0, 0, 0.2);
    selection-background-color: #4272FF;
    selection-color: #ffffff;
}
QHeaderView {
    background-color: rgba(0,0,0,0);
}
/* Header styles */
QHeaderView::section {
    background-color: #E5E5E5;
    color: #000000;
    padding: 4px;
	border-radius: 2px;
    border: 1px solid rgba(0, 0, 0, 0.2);
    font-weight: bold;
    text-align: center;
}

/* Cell styles */
QTableWidget::item {
	background-color: rgb(255, 255, 255);
    border: 1px solid rgba(0, 0, 0, 0.1);
    padding: 2px;
}

/* Selected cell styles */
QTableWidget::item:selected {
    background-color: #4272FF;
    color: #ffffff;
}

QTableView QTableCornerButton::section {
	background-color: rgba(0,0,0,0.05);
    border-radius: 5px;
}

/* Scrollbar styles */
QScrollBar:vertical {
    background-color: #e6e6e6;
    width: 12px;
    margin: 20px 0 20px 0;
}

QScrollBar::handle:vertical {
    background: #bfbfbf;
    min-height: 20px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    background: #f0f0f0;
    height: 20px;
    subcontrol-origin: margin;
    subcontrol-position: top;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background-color: #e6e6e6;
    height: 12px;
    margin: 0 20px 0 20px;
}

QScrollBar::handle:horizontal {
    background: #bfbfbf;
    min-width: 20px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    background: #f0f0f0;
    width: 20px;
    subcontrol-origin: margin;
    subcontrol-position: left;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

QGraphicsView {
	border: 0px;
	background-color: transparent;
}


QTreeView {
	background-color: rgb(250, 250, 250);
}

QTreeView::item {
     border: 1px solid #d9d9d9;
    border-top-color: transparent;
    border-bottom-color: transparent;
}

QTreeView::item:hover {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #e7effd, stop: 1 #cbdaf1);
    border: 1px solid #bfcde4;
}

QTreeView::item:selected {
    border: 1px solid #567dbc;
}

QTreeView::item:selected:active{
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #6ea1f1, stop: 1 #567dbc);
}

QTreeView::item:selected:!active {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #6b9be8, stop: 1 #577fbf);
}

QTreeView::branch:has-siblings:!adjoins-item {
    border-image: url(yeni_gui/uis/icons/new_v2/vline.png) 0;
}

QTreeView::branch:has-siblings:adjoins-item {
    border-image: url(yeni_gui/uis/icons/new_v2/branch-more.png) 0;
}

QTreeView::branch:!has-children:!has-siblings:adjoins-item {
    border-image: url(yeni_gui/uis/icons/new_v2/branch-end.png) 0;
}

QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
        border-image: none;
        image: url(yeni_gui/uis/icons/new_v2/branch-closed.png);
}

QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings  {
        border-image: none;
        image: url(yeni_gui/uis/icons/new_v2/branch-open.png);
}
</string>
